{
  "name": "dsh-plugin-nijika-theme",
  "version": "0.1.0",
  "description": "DSH / DeepSeek Harness 伊地知虹夏主题：结束乐队橙色系暖色皮肤，覆盖全部语义界面令牌",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "theme",
    "skin",
    "nijika",
    "bocchi",
    "kessoku-band",
    "dsh-theme"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
